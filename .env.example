# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=claude_usage

# Password for the dashboard
DASHBOARD_PASSWORD=change-me

# Secret key PCs use to send usage data. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INGEST_TOKEN=

# Optional
# SESSION_SECRET=          # defaults to DASHBOARD_PASSWORD
# DASHBOARD_TZ=Asia/Dubai  # timezone for daily grouping and times
# PUBLIC_URL=https://your-app.vercel.app  # override the URL in the setup command
